<resources>
    <style name="Theme.Vojs" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/vojs_splash_background</item>
    </style>
    <style name="Theme.Vojs.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vojs_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Vojs</item>
    </style>
</resources>
